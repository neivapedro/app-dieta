# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Settings → API). Sem estas variáveis o app roda em "modo demonstração",
# salvando só no navegador.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Chave pública VAPID (gerada com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
